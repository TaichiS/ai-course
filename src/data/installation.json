    {
      "id": "troubleshooting",
      "title": "常見問題與錯誤排解",
      "icon": "AlertTriangle",
      "color": "red",
      "description": "安裝過程中可能遇到的問題與解決方案",
      "issues": [
        {
          "problem": "npm 權限錯誤",
          "solution": "使用 sudo（MacOS/Linux）或以管理員身份執行（Windows）",
          "command": "sudo npm install -g @anthropic-ai/claude-code"
        },
        {
          "problem": "找不到 node 或 npm 命令",
          "solution": "確認 NodeJS 已正確安裝並加入 PATH。Windows 使用者請確認安裝時有勾選「Add to PATH」選項"
        },
        {
          "problem": "找不到 python 或 python3 命令",
          "solution": "確認 Python 已正確安裝並加入 PATH。Windows 使用者請確認安裝時有勾選「Add to PATH」選項"
        },
        {
          "problem": "PowerShell 執行策略錯誤",
          "solution": "以管理員身份開啟 PowerShell 並執行以下命令",
          "command": "Set-ExecutionPolicy -ExecutionPolicy RemoteSigned"
        },
        {
          "problem": "API Key 設定錯誤",
          "solution": "確認環境變數已正確設定，並重新啟動終端機",
          "command": "export ANTHROPIC_API_KEY=\"your-api-key\""
        },
        {
          "problem": "Claude Code 安裝後找不到 claude 命令",
          "solution": "確認安裝路徑已加入 PATH 環境變數，並重新開啟終端機"
        }
      ]
    },
