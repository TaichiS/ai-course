  "sections": [
    {
      "id": "one-click-setup",
      "title": "Windows 一鍵自動安裝 (推薦)",
      "icon": "Download",
      "color": "indigo",
      "description": "自動化檢查並安裝 Git, Node.js, Python, VS Code, UV 與 Claude Code",
      "is_new": true,
      "steps": [
        {
          "title": "執行安裝指令",
          "description": "請以「系統管理員身分」開啟 PowerShell，然後複製貼上並執行以下指令，即可自動搞定所有複雜的安裝與路徑設定。",
          "showInstallCommand": true,
          "note": "注意：執行時若跳出權限請求，請選擇「是」/「確認」或直接按 Y。"
        },
        {
          "title": "驗證與登入",
          "description": "安裝完成後，請重新開啟一個新的 PowerShell 視窗，輸入 `claude` 進入互動模式，再輸入 `/login` 登入您的 Google 帳號：",
          "commands": ["claude", "/login"]
        }
      ]
    },
    {
      "id": "nodejs",
      "title": "Node.js 與 VS Code 安裝",
      "icon": "Download",
      "color": "green",
      "description": "安裝基礎開發環境",
      "steps": [
        {
          "title": "下載 Node.js",
          "description": "下載 Node.js 18 或更新版本",
          "url": "https://nodejs.org/",
          "note": "建議安裝 LTS (長期支援) 版本"
        },
        {
          "title": "驗證安裝",
          "commands": ["node --version", "npm --version"]
        },
        {
          "title": "確認 npx 工具",
          "description": "npx 是 Node.js 官方隨 npm 5.2.0 以上版本一起提供的命令列工具，主要用於「臨時執行 npm 套件中的命令行工具」，無需先全域安裝。"
        }
      ],
      "tips": [
        "npx 可直接執行 npm 套件中的 CLI 工具，不需要手動全域安裝",
        "執行過程中，若本地已安裝該套件會優先使用本地版本，否則自動臨時下載並執行",
        "支援指定版本、參數，避免環境污染"
      ]
    },
    {
      "id": "python",
      "title": "Python 與 UV/UVX 安裝",
      "icon": "Terminal",
      "color": "blue",
      "description": "安裝 Python 套件管理工具",
      "steps": [
        {
          "title": "確認 Python 3.x 已安裝",
          "commands": ["python --version", "python3 --version"]
        },
        {
          "title": "安裝 UV/UVX（Windows PowerShell）",
          "commands": ["powershell -ExecutionPolicy ByPass -c \"irm https://astral.sh/uv/install.ps1 | iex\""]
        },
        {
          "title": "安裝 UV/UVX（MacOS/Linux）",
          "commands": ["curl -LsSf https://astral.sh/uv/install.sh | sh"]
        }
      ],
      "info": "UV 是一款由 Rust 開發的超高速 Python 套件與專案管理工具，目標是整合和取代 pip、pip-tools、pipx、poetry、pyenv 等工具。UVX 則是 UV 工具中的「即用即走」工具指令，主要用於在隔離、臨時環境中快速執行 Python 命令列工具。"
    },
    {
      "id": "claude-code",
      "title": "Claude Code 安裝",
      "icon": "Terminal",
      "color": "purple",
      "description": "安裝 Anthropic 的 AI 助理工具",
      "methods": {
        "new": {
          "title": "新式安裝方法（推薦）",
          "platforms": {
            "macos": "brew install --cask claude-code",
            "windows_powershell": "irm https://claude.ai/install.ps1 | iex",
            "windows_cmd": "curl -fsSL https://claude.ai/install.cmd -o install.cmd && install.cmd && del install.cmd"
          }
        },
        "old": {
          "title": "舊式安裝方法",
          "commands": ["npm install -g @anthropic-ai/claude-code", "npm list -g"]
        }
      },
      "windows_setup": {
        "title": "Windows 必要配置",
        "description": "Windows 的 PowerShell 預設會阻擋執行腳本，需要調整執行策略",
        "steps": [
          "使用管理員模式打開 PowerShell",
          "執行以下指令並按 Y"
        ],
        "command": "Set-ExecutionPolicy -ExecutionPolicy RemoteSigned"
      },
      "path_setup": {
        "title": "PATH 環境變數設定（如果出現錯誤）",
        "description": "如果安裝後出現 PATH 相關錯誤，請在 PowerShell 中執行以下命令，然後重新開啟 PowerShell",
        "command": "[Environment]::SetEnvironmentVariable(\n    \"Path\",\n    [Environment]::GetEnvironmentVariable(\"Path\", \"User\") + \";C:\\Users\\YOUR_USERNAME\\.local\\bin\",\n    \"User\"\n)",
        "note": "請將 YOUR_USERNAME 替換為您的 Windows 使用者名稱"
      },
      "management": {
        "update": "npm update -g @anthropic-ai/claude-code",
        "uninstall": "npm uninstall -g @anthropic-ai/claude-code",
        "config_path": "~/.claude.json 或 ~/.claude/"
      }
    },
    {
      "id": "gemini-cli",
